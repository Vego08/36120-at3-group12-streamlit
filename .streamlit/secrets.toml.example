# Copy this file to .streamlit/secrets.toml (never commit the real file) and fill in the Render URLs.
# On Streamlit Community Cloud, paste the same lines into App settings > Secrets.
STUDENT_A_API_URL = "https://<student-a-service>.onrender.com"
STUDENT_B_API_URL = "https://<student-b-service>.onrender.com"
STUDENT_C_API_URL = "https://<student-c-service>.onrender.com"
STUDENT_D_API_URL = "https://<student-d-service>.onrender.com"
